{
  "name": "offthemode",
  "version": "0.1.0",
  "private": true,
  "description": "A prompt-engineering setup that makes any AI coding tool plan first, build in order, and hold an elite bar.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "node scripts/build-content.mjs && next dev",
    "build": "node scripts/build-content.mjs && next build",
    "start": "next start",
    "check": "node scripts/build-content.mjs --check && tsc --noEmit",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:view": "node scripts/test-view.mjs",
    "audit": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "mcp-handler": "^2.2.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fflate": "^0.8.3",
    "marked": "^18.0.14",
    "typescript": "^5.9.3"
  }
}
